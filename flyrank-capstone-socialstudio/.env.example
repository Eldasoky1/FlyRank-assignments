# Social Media Studio
# OAuth token encryption secret. DO NOT commit a real value; keep in .env
OAUTH_SECRET=replace-with-a-long-random-secret

# SQLite database path (durable scheduler)
SOCIAL_DB=tasks.db

# Crash recovery: reclaim stuck 'running' jobs older than N seconds
STALE_SECS=300

# Webhook shared secrets per platform (must match your platform app config)
FB_WEBHOOK_SECRET=fb_webhook_secret_dev
TW_WEBHOOK_SECRET=tw_webhook_secret_dev
