# Copy to `.env` and fill in a free provider (Groq / OpenRouter / etc).
# NEVER commit the real `.env`.

# Provider that is OpenAI-compatible and free / no-credit-card (e.g. Groq).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Timeout for each model call (seconds).
LLM_TIMEOUT=25
# Number of retries on a bad/transient response (sane stop condition).
LLM_MAX_RETRIES=2

PORT=8000
