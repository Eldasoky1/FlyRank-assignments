# FlyRank MCP configuration.
# Copy this file to `.env` (it is gitignored) and fill in YOUR OWN values.
# Never paste credentials into a chat — write them into `.env` yourself.

# Base URL of the FlyRank internship portal.
FLYRANK_BASE_URL=https://internship.flyrank.ai

# Your portal session cookie, e.g.  session=abc123...   (login in a browser, copy the Cookie header value)
# FLYRANK_COOKIE=session=....

# OR a scoped API/Bearer token, if the portal issues one.
# FLYRANK_API_TOKEN=....

# Where discovered endpoints are recorded. Defaults to ~/.flyrank-mcp
# FLYRANK_STATE_DIR=